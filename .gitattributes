# Normalize all text files to LF in the repo, checked out as LF on every OS.
# Prevents the CRLF/LF churn that made every file look "modified" on Windows.
* text=auto eol=lf

# Binary assets: never normalize these.
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

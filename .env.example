# Create a free Supabase project, then copy its Project URL and publishable anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: live AI chat via a direct OpenAI-compatible endpoint.
# When set, the assistant calls this endpoint instead of the local brain.
# For a secure setup, prefer the Supabase Edge Function in supabase/functions/ai-chat.
# VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=your-llm-api-key
# VITE_AI_MODEL=gpt-4o-mini

# Bank details customers see when paying an order by transfer (checkout and
# the Orders page). The real account is already set as a default in
# src/media.js (Palmpay / 9061965441 / Bolatito Roqeebah Kehinde);
# uncomment and edit these only if you change banks.
